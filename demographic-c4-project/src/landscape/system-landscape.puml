@startuml "DemoScope - System Landscape (Level 0)"
' Подключение официальной библиотеки макросов C4 напрямую из GitHub
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title Диаграмма системного ландшафта (Level 0) — встраивание веб-интерфейса DemoScope в государственную ИТ-инфраструктуру

Person(analyst, "Демограф-аналитик", "Сотрудник регионального ведомства: моделирует сценарии и запускает прогнозы")
Person(official, "Представитель органов власти", "Руководитель: просматривает дашборды, тепловые карты и справки")

Enterprise_Boundary(gov_it, "Государственная ИТ-инфраструктура РФ (защищённый контур органов власти)") {
    System_Boundary(demoscope, "ИС мониторинга и прогнозирования населения РФ (DemoScope)") {
        Container(web_app, "Веб-интерфейс аналитика", "React 18 / TypeScript", "Единая точка входа пользователей: мониторинг, прогноз, тепловые карты, отчёты")
        Container(api_backend, "API Gateway & Core Service", "Python / FastAPI", "Бизнес-логика, маршрутизация запросов и интеграции")
    }
    System(esia, "ЕСИА (IAM)", "Единая система идентификации и аутентификации: вход по учётной записи Госуслуг, роли пользователей")
    System(emiss, "ЕМИСС / Росстат", "Единая межведомственная информационно-статистическая система: официальные демографические ряды")
    System(gas_upr, "ГАС «Управление»", "Государственная система мониторинга показателей социально-экономического развития")
}

System_Ext(ebudget, "ГИИС «Электронный бюджет»", "Внешняя финансовая система Минфина России: планирование расходов бюджетов")
System_Ext(gis_service, "Геоинформационный сервис (GIS)", "Картографическая подложка и векторные границы регионов")

Rel(analyst, web_app, "Задаёт сценарии, запускает прогноз, анализирует результаты", "HTTPS / TLS 1.3")
Rel(official, web_app, "Просматривает дашборды, карты и справки", "HTTPS / TLS 1.3")
Rel(web_app, esia, "Перенаправляет пользователя на вход, получает токены", "HTTPS / OAuth2 + OIDC (PKCE)")
Rel(web_app, api_backend, "Запрашивает показатели, прогнозы и отчёты", "HTTPS / JSON, WSS")
Rel(web_app, gis_service, "Загружает тайлы и границы регионов", "HTTPS / REST")
Rel(api_backend, esia, "Проверяет access-токены и права доступа", "HTTPS / OAuth2 (introspection)")
Rel(api_backend, emiss, "Синхронизирует ряды численности и естественного движения", "gRPC / TLS")
Rel(api_backend, gas_upr, "Публикует прогнозные показатели для мониторинга", "gRPC / TLS")
Rel(api_backend, ebudget, "Передаёт прогноз численности для планирования социальных расходов", "HTTPS / REST, ГОСТ TLS")
@enduml
